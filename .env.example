# Copie para .env e preencha. O .env nunca deve ir para o Git.

# Gere valores longos e aleatorios para estes tres (veja o README).
POSTGRES_PASSWORD=troque-isto
SECRET_KEY=troque-isto
BACKUP_KEY=troque-isto

# Pasta do Windows onde os backups criptografados ficam. Use barras normais.
BACKUP_PATH=C:/Financas/backups

# Somente estes e-mails podem se cadastrar (separados por virgula).
ALLOWED_EMAILS=voce@gmail.com,sua-conjuge@gmail.com

# Envio dos codigos pelo Gmail. SMTP_PASSWORD e a senha de app de 16 letras.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=remetente@gmail.com
SMTP_PASSWORD=
SMTP_FROM=remetente@gmail.com

# Regras do codigo por e-mail
CODE_TTL_SECONDS=60
CODE_MAX_RESENDS=5
CODE_LOCK_MINUTES=15
CODE_MAX_ATTEMPTS=5

# Use true quando acessar por HTTPS (tailscale serve).
COOKIE_SECURE=true

# Funcionalidades desligadas, separadas por virgula. Exemplo: desafios,reserva
DISABLED_MODULES=
